# Infra Arcana for GFOS (AmigaOS 3.2 with GFOpenUp), 68040/68060 + FPU, on
# GFOpenUp's SDL 2 (LIBS:GFOpenGPU/SDL2.module, SDL2_image.module and
# SDL2_mixer.module).
#
#   make -f amiga/Makefile.amigaos -j4 [STOVE=/path/to/os32-gcc16-open6]
#
# STOVE is a GFOpenAmigaGCC 16.2.0-open6 stove: its prefix/ has the
# compiler, the NDK and GFOpenGPU's SDL 2 kit (prefix/m68k-amigaos).
# The sources are CMakeLists.txt's ia target (with upstream's bundled
# tinyxml2 and mINI); the drawer listing and the current directory come from
# amiga/amiga_dir.cpp, in place of std::filesystem.
#
# Output: build/amigaos/InfraArcana/ (the drawer: InfraArcana, upstream's
# gfx/, audio/ and data/, User/, ReadMe, Controls, the manual and licences,
# with GlowIcons), build/amigaos/InfraArcana.info and Install-InfraArcana
# beside them.

STOVE   ?= $(HOME)/AmiCradle/stoves/os32-gcc16-open6
PREFIX  ?= $(STOVE)/prefix
KIT     ?= $(PREFIX)/m68k-amigaos
CXX     = $(PREFIX)/bin/m68k-amigaos-g++
CPU     ?= -m68040 -m68881
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile (the kit's
# sdl2-config gives it for GCC 16 too).
OPT     ?= -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns

DEFS    = -D__amigaos__ -DNDEBUG
INC     = -Iinclude -Iamiga -Ithird_party/tinyxml2 -Ithird_party/mINI-0.9.17/src/mini \
          -I$(KIT)/include/SDL2 -I$(KIT)/include
CXXFLAGS = -noixemul $(OPT) $(CPU) -std=c++17 $(DEFS) $(INC)
LDFLAGS = -noixemul $(CPU)
LIBS    = -L$(KIT)/lib -lSDL2_mixer -lSDL2_image -lSDL2 -lpthread -latomic -lm

BUILD   = build/amigaos
OBJDIR  = $(BUILD)/obj
OUT     = $(BUILD)/InfraArcana
PROG    = InfraArcana

SRC     = src/ability_values.cpp \
          src/actor.cpp \
          src/actor_act.cpp \
          src/actor_common.cpp \
          src/actor_cycle_graphics.cpp \
