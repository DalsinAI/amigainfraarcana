          amiga/amiga_start.cpp
OBJS    = $(SRC:%.cpp=$(OBJDIR)/%.o)

DOCS    = manual.txt credits.txt release_history.txt contact.txt LICENSE.txt \
          LICENSE-AUDIO.txt LICENSE-FONTS.txt LICENSE-FONT-DEJAVU.txt

all: $(OUT)/$(PROG) package

$(OUT)/$(PROG): $(OBJS)
	@mkdir -p $(OUT)
	$(CXX) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

package: $(OUT)/$(PROG) AMIGA_PORT.md amiga/Licences.txt amiga/Controls
	mkdir -p $(OUT)/User
	rm -rf $(OUT)/gfx $(OUT)/audio $(OUT)/data
	cp -R installed_files/gfx $(OUT)/gfx
	cp -R installed_files/audio $(OUT)/audio
	cp -R installed_files/data $(OUT)/data
	git log -1 --format=%h > $(OUT)/data/git-sha1.txt 2>/dev/null || true
	for f in $(DOCS); do cp installed_files/$$f $(OUT)/$$f; \
	    cp amiga/icons/ReadMe.info $(OUT)/$$f.info; done
	cp third_party/mINI-0.9.17/LICENSE $(OUT)/LICENSE-mINI.txt
	cp third_party/tinyxml2/LICENSE.txt $(OUT)/LICENSE-tinyxml2.txt
	cp amiga/Controls $(OUT)/Controls
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp amiga/Licences.txt $(OUT)/Licences.txt
	cp amiga/icons/InfraArcana.info amiga/icons/ReadMe.info $(OUT)/
	for f in Controls Licences.txt LICENSE-mINI.txt LICENSE-tinyxml2.txt; do \
	    cp amiga/icons/ReadMe.info $(OUT)/$$f.info; done
	cp amiga/icons/Data.info $(OUT)/User.info
	cp amiga/icons/InfraArcana-drawer.info $(BUILD)/InfraArcana.info
	cp amiga/Install-InfraArcana amiga/Install-InfraArcana.info $(BUILD)/

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

objs: $(OBJS)

clean:
	rm -rf $(BUILD)

.PHONY: all package objs clean
